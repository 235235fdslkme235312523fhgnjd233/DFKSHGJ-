    function UIBase:newTabList()
        assert(self.child == nil, "UIBase:newTabList -> child already exists")
        local tabList = UITabList.new(self)
        self.child = tabList
        return tabList
    end
    function UIBase:encodeJSON()
        local config = {}
        for flag, feature in pairs(self.features) do
            if typeof(feature.value) == "table" then
                local clone = table.clone(feature.value)
                for k, v in pairs(clone) do
                    if typeof(v) == "Color3" then
                        clone[k] = { v.R, v.G, v.B }
                    elseif typeof(v) == "EnumItem" then
                        clone[k] = { "Enum", v.EnumType and tostring(v.EnumType) or "Unknown", v.Name or "None" }
                    end
                end
                config[flag] = clone
            else
                config[flag] = feature.value
            end
        end
        return HttpService:JSONEncode(config)
    end
    function UIBase:decodeJSON(json)
        local decoded
        local ok = pcall(function() decoded = HttpService:JSONDecode(json) end)
        if not ok or type(decoded) ~= "table" then return false, "invalid json" end
        for flag, value in pairs(decoded) do
            local feature = self.features[flag]
            if feature then
                pcall(function()
                    if type(value) == "table" then
                        if value.rgb and value.alpha then
                            feature:set({ rgb = Color3.new(value.rgb[1], value.rgb[2], value.rgb[3]), alpha = value.alpha })
                        elseif value.key and value.mode then
                            feature:set({ key = Enum[value.key[2]][value.key[3]], mode = value.mode })
                        else
                            feature:set(value)
                        end
                    else
                        feature:set(value)
                    end
                end)
            end
        end
        return true
    end
    function UIBase:Finish()
        if setidentity then setidentity(8) end
        self.instances.gui.Parent = CoreGui
    end
    function UIBase:Destroy()
        self._trove:Clean()
    end

