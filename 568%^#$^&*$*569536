    function UIDropdown:set(value)
        if self.value == value and not self.multi then return end
        self.value = value
        if typeof(value) == "table" then
            local res = ""
            for _, option in ipairs(self.options) do
                if value[option] then res ..= option .. ", " end
            end
            self.instances.value.Text = (#res == 0) and "..." or string.sub(res, 1, #res - 2)
        else
            self.instances.value.Text = value or "None"
        end
        self.changed:Fire(self.value)
