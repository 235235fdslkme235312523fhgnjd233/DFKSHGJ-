    -- ============================================================
    -- Trove
    -- ============================================================
    local Trove = (function()
        local FN_MARKER, THREAD_MARKER = newproxy(), newproxy()
        local GENERIC = table.freeze({ "Destroy", "Disconnect", "destroy", "disconnect" })

        local function getCleanup(object, method)
            local t = typeof(object)
            if t == "function" then return FN_MARKER end
            if t == "thread"   then return THREAD_MARKER end
            if method then return method end
            if t == "Instance" then return "Destroy" end
            if t == "RBXScriptConnection" then return "Disconnect" end
            if t == "table" then
                for _, m in GENERIC do
                    if type(object[m]) == "function" then return m end
                end
            end
            error(("failed to get cleanup function for object %s: %s"):format(t, tostring(object)), 3)
        end

        local function assertPromise(p)
            if typeof(p) ~= "table" or typeof(p.getStatus) ~= "function"
                or typeof(p.finally) ~= "function" or typeof(p.cancel) ~= "function" then
                error("did not receive a promise as an argument", 3)
            end
        end

        local T = {}
        T.__index = T
        function T.new()
            return setmetatable({ _objects = {}, _cleaning = false }, T)
        end
        function T:Add(object, method)
            if self._cleaning then error("cannot call trove:Add() while cleaning", 2) end
            table.insert(self._objects, { object, getCleanup(object, method) })
            return object
        end
        function T:Clone(instance)
            if self._cleaning then error("cannot call trove:Clone() while cleaning", 2) end
            return self:Add(instance:Clone())
        end
        function T:Construct(class, ...)
            if self._cleaning then error("cannot call trove:Construct() while cleaning", 2) end
            local object
            local t = type(class)
            if t == "table" then object = class.new(...)
            elseif t == "function" then object = class(...) end
            return self:Add(object)
        end
        function T:Connect(signal, fn)
            if self._cleaning then error("cannot call trove:Connect() while cleaning", 2) end
            return self:Add(signal:Connect(fn))
        end
        function T:BindToRenderStep(name, priority, fn)
            if self._cleaning then error("cannot call trove:BindToRenderStep() while cleaning", 2) end
            RunService:BindToRenderStep(name, priority, fn)
            self:Add(function() RunService:UnbindFromRenderStep(name) end)
        end
        function T:AddPromise(promise)
            if self._cleaning then error("cannot call trove:AddPromise() while cleaning", 2) end
            assertPromise(promise)
            if promise:getStatus() == "Started" then
                promise:finally(function()
                    if self._cleaning then return end
                    self:_remove(promise, false)
                end)
                self:Add(promise, "cancel")
            end
            return promise
        end
        function T:Remove(object)
            if self._cleaning then error("cannot call trove:Remove() while cleaning", 2) end
            return self:_remove(object, true)
        end
        function T:Extend()
            if self._cleaning then error("cannot call trove:Extend() while cleaning", 2) end
            return T.new()
        end
        function T:Clean()
            if self._cleaning then return end
            self._cleaning = true
            for _, obj in self._objects do
                self:_cleanup(obj[1], obj[2])
            end
            table.clear(self._objects)
            self._cleaning = false
        end
        function T:_remove(object, cleanup)
            local objects = self._objects
            for i, obj in ipairs(objects) do
                if obj[1] == object then
                    local n = #objects
                    objects[i] = objects[n]
                    objects[n] = nil
                    if cleanup then self:_cleanup(obj[1], obj[2]) end
                    return true
                end
            end
            return false
        end
        function T:_cleanup(object, method)
            if method == FN_MARKER then
                object()
            elseif method == THREAD_MARKER then
                pcall(task.cancel, object)
            else
                object[method](object)
            end
        end
        function T:AttachToInstance(instance)
            if self._cleaning then error("cannot call trove:AttachToInstance() while cleaning", 2) end
            if not instance:IsDescendantOf(game) then
                error("instance is not a descendant of the game hierarchy", 2)
            end
            return self:Connect(instance.Destroying, function() self:Destroy() end)
        end
        function T:Destroy() self:Clean() end
        return { new = T.new }
    end)()

    -- ============================================================
    -- Signal
    -- ============================================================
    local Signal = (function()
        local freeRunnerThread
        local function acquire(fn, ...)
            local t = freeRunnerThread
            freeRunnerThread = nil
            fn(...)
            freeRunnerThread = t
        end
        local function runner(...)
            acquire(...)
            while true do acquire(coroutine.yield()) end
        end

        local Connection = {}
        Connection.__index = Connection
        function Connection:Disconnect()
            if not self.Connected then return end
            self.Connected = false
            if self._signal._handlerListHead == self then
                self._signal._handlerListHead = self._next
            else
                local prev = self._signal._handlerListHead
                while prev and prev._next ~= self do prev = prev._next end
                if prev then prev._next = self._next end
            end
        end
        Connection.Destroy = Connection.Disconnect
        setmetatable(Connection, {
            __index = function(_, k) error(("Attempt to get Connection::%s (not a valid member)"):format(tostring(k)), 2) end,
            __newindex = function(_, k) error(("Attempt to set Connection::%s (not a valid member)"):format(tostring(k)), 2) end,
        })

        local S = {}
        S.__index = S
        function S.new()
            return setmetatable({ _handlerListHead = false, _proxyHandler = nil, _yieldedThreads = nil }, S)
        end
        function S.Wrap(rbx)
            assert(typeof(rbx) == "RBXScriptSignal", "Argument #1 to Signal.Wrap must be RBXScriptSignal")
            local s = S.new()
            s._proxyHandler = rbx:Connect(function(...) s:Fire(...) end)
            return s
        end
        function S.Is(o) return type(o) == "table" and getmetatable(o) == S end
        function S:Connect(fn)
            local c = setmetatable({ Connected = true, _signal = self, _fn = fn, _next = false }, Connection)
            if self._handlerListHead then
                c._next = self._handlerListHead
                self._handlerListHead = c
            else
                self._handlerListHead = c
            end
            return c
        end
        S.ConnectOnce = function(self, fn) return self:Once(fn) end
        function S:Once(fn)
            local c, done
            c = self:Connect(function(...)
                if done then return end
                done = true
                c:Disconnect()
                fn(...)
            end)
            return c
        end
        function S:GetConnections()
            local items = {}
            local item = self._handlerListHead
            while item do table.insert(items, item); item = item._next end
            return items
        end
        function S:DisconnectAll()
            local item = self._handlerListHead
            while item do item.Connected = false; item = item._next end
            self._handlerListHead = false
            local y = rawget(self, "_yieldedThreads")
            if y then
                for thread in y do
                    if coroutine.status(thread) == "suspended" then task.cancel(thread) end
                end
                table.clear(y)
            end
        end
        function S:Fire(...)
            local item = self._handlerListHead
            while item do
                if item.Connected then
                    if not freeRunnerThread then
                        freeRunnerThread = coroutine.create(runner)
                    end
                    task.spawn(freeRunnerThread, item._fn, ...)
                end
                item = item._next
            end
        end
        function S:FireDeferred(...)
            local item = self._handlerListHead
            while item do
                local c = item
                task.defer(function(...) if c.Connected then c._fn(...) end end, ...)
                item = item._next
            end
        end
        function S:Wait()
            local y = rawget(self, "_yieldedThreads")
            if not y then y = {}; rawset(self, "_yieldedThreads", y) end
            local thread = coroutine.running()
            y[thread] = true
            self:Once(function(...) y[thread] = nil; task.spawn(thread, ...) end)
            return coroutine.yield()
        end
        function S:Destroy()
            self:DisconnectAll()
            local p = rawget(self, "_proxyHandler")
            if p then p:Disconnect() end
        end
        setmetatable(S, {
            __index = function(_, k) error(("Attempt to get Signal::%s (not a valid member)"):format(tostring(k)), 2) end,
            __newindex = function(_, k) error(("Attempt to set Signal::%s (not a valid member)"):format(tostring(k)), 2) end,
        })
        return table.freeze({ new = S.new, Wrap = S.Wrap, Is = S.Is })
    end)()

    -- ============================================================
    -- Utils
    -- ============================================================
    local function inside(x, y, pX, pY, sX, sY)
        return x > pX and x < pX + sX and y > pY and y < pY + sY
    end
    local function insideFrame(input, frame)
        local p, s = frame.AbsolutePosition, frame.AbsoluteSize
        return inside(input.X, input.Y, p.X, p.Y, s.X, s.Y)
    end

