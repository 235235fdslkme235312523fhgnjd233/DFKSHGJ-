function Library:UpdateBlur()
    if Library.UseBlur and Library.Toggled then
        Library.BlurEffect.Enabled = true
        Library:_Tween(Library.BlurEffect, TweenInfo.new(0.2), {Size = Library.BlurSize})
    else
        Library:_Tween(Library.BlurEffect, TweenInfo.new(0.2), {Size = 0})
        task.delay(0.2, function()
            if not Library.UseBlur or not Library.Toggled then
                Library.BlurEffect.Enabled = false
            end
        end)
    end
end

-- ─────────────────────────────────────────────
--  Tween pool (no GC churn)
-- ─────────────────────────────────────────────
function Library:_Tween(instance, info, props)
    local key = instance
    local existing = Library._tweenPool[key]
    if existing then
        pcall(function() existing:Cancel() end)
    end
    local tween = TweenService:Create(instance, info, props)
    Library._tweenPool[key] = tween
    -- trim pool
    local n = 0
    for _ in pairs(Library._tweenPool) do n = n + 1 end
    if n > Library._tweenPoolMax then
        for k in pairs(Library._tweenPool) do
            Library._tweenPool[k] = nil
            n = n - 1
            if n <= Library._tweenPoolMax then break end
        end
    end
    tween:Play()
    return tween
end

-- ─────────────────────────────────────────────
--  Text bounds LRU
-- ─────────────────────────────────────────────
function Library:GetTextBounds(text, font, size, res)
    local key = text .. '\0' .. tostring(font) .. '\0' .. tostring(size)
    local cached = Library._textCache[key]
    if cached then return cached[1], cached[2] end
    local b = TextService:GetTextSize(text, size, font, res or Vector2.new(1920, 1080))
    Library._textCache[key] = {b.X, b.Y}
    table.insert(Library._textCacheOrder, key)
    if #Library._textCacheOrder > Library._textCacheMax then
        local old = table.remove(Library._textCacheOrder, 1)
        Library._textCache[old] = nil
    end
    return b.X, b.Y
end

function Library:GetDarkerColor(color)
    local h, s, v = Color3.toHSV(color)
    return Color3.fromHSV(h, s, v / 1.5)
end

-- ─────────────────────────────────────────────
--  Signal bag
-- ─────────────────────────────────────────────
function Library:GiveSignal(signal)
    table.insert(Library.Signals, signal)
    return signal
end

function Library:Unload()
    for i = #Library.Signals, 1, -1 do
        local c = table.remove(Library.Signals, i)
        pcall(function() c:Disconnect() end)
    end
    if Library.OnUnload then pcall(Library.OnUnload) end
    if Library.BlurEffect then pcall(function() Library.BlurEffect:Destroy() end) end
    pcall(function() ScreenGui:Destroy() end)
end

function Library:OnUnload(cb) Library.OnUnload = cb end

-- ─────────────────────────────────────────────
--  Safe callback
-- ─────────────────────────────────────────────
function Library:SafeCallback(f, ...)
    if not f then return end
    if not Library.NotifyOnError then return f(...) end
    local ok, err = pcall(f, ...)
    if not ok then
        local _, i = tostring(err):find(':%d+: ')
        Library:Notify(i and tostring(err):sub(i + 1) or tostring(err), 3)
    end
end

function Library:AttemptSave()
    if Library.SaveManager then pcall(function() Library.SaveManager:Save() end) end
end

-- ─────────────────────────────────────────────
--  Instance helpers
-- ─────────────────────────────────────────────
function Library:Create(class, props)
    local inst = class
    if type(class) == 'string' then inst = Instance.new(class) end
    for k, v in next, props do inst[k] = v end
    if inst:IsA('TextLabel') or inst:IsA('TextBox') or inst:IsA('TextButton') then
        local offset = props.TextSize and (props.TextSize - Library.FontSize) or 0
        inst:SetAttribute('FontSizeOffset', offset)
    end
    return inst
end

function Library:ApplyTextStroke(inst)
    inst.TextStrokeTransparency = 1
    Library:Create('UIStroke', {
        Color = Color3.new(0, 0, 0),
        Thickness = 1,
        LineJoinMode = Enum.LineJoinMode.Miter,
        Parent = inst,
    })
end

function Library:CreateLabel(props, isHud)
    local l = Library:Create('TextLabel', {
        BackgroundTransparency = 1,
        Font = Library.Font,
        TextColor3 = Library.FontColor,
        TextSize = Library.FontSize + 2,
        TextStrokeTransparency = 0,
    })
    Library:ApplyTextStroke(l)
    Library:AddToRegistry(l, {TextColor3 = 'FontColor'}, isHud)
    return Library:Create(l, props)
end

function Library:AddToRegistry(instance, props, isHud)
    local data = {Instance = instance, Properties = props}
    Library.RegistryMap[instance] = data
    table.insert(Library.Registry, data)
    if isHud then table.insert(Library.HudRegistry, data) end
end

function Library:RemoveFromRegistry(instance)
    local data = Library.RegistryMap[instance]
    if not data then return end
    for i = #Library.Registry, 1, -1 do
        if Library.Registry[i] == data then table.remove(Library.Registry, i) end
    end
    for i = #Library.HudRegistry, 1, -1 do
        if Library.HudRegistry[i] == data then table.remove(Library.HudRegistry, i) end
    end
    Library.RegistryMap[instance] = nil
end

function Library:UpdateColorsUsingRegistry()
    Library.AccentColorDark = Library:GetDarkerColor(Library.AccentColor)
    for _, obj in next, Library.Registry do
        for prop, colorKey in next, obj.Properties do
            if type(colorKey) == 'string' then
                pcall(function() obj.Instance[prop] = Library[colorKey] end)
            elseif type(colorKey) == 'function' then
                pcall(function() obj.Instance[prop] = colorKey() end)
            end
        end
    end
end

