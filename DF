function Library:Create(Class, Properties)
    local inst = Class
    if type(Class) == 'string' then
        inst = Instance.new(Class)
    end
    if Properties then
        for prop, value in next, Properties do
            inst[prop] = value
        end
    end
    if inst:IsA('TextLabel') or inst:IsA('TextBox') or inst:IsA('TextButton') then
        local base = Properties and Properties.TextSize
        inst:SetAttribute('FontSizeOffset', (base and (base - Library.FontSize)) or 0)
        Library._FontTargets[inst] = true
    end
    return inst
end

