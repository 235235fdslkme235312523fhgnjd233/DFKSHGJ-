local BlurTween
function Library:UpdateBlur()
    if BlurTween then BlurTween:Cancel() end
    if Library.UseBlur and Library.Toggled then
        Library.BlurEffect.Enabled = true
        BlurTween = TweenService:Create(
            Library.BlurEffect,
            TweenInfo.new(0.2, Enum.EasingStyle.Linear),
            { Size = Library.BlurSize }
        )
        BlurTween:Play()
    else
        BlurTween = TweenService:Create(
            Library.BlurEffect,
            TweenInfo.new(0.2, Enum.EasingStyle.Linear),
            { Size = 0 }
        )
        BlurTween:Play()
        BlurTween.Completed:Connect(function()
            if not (Library.UseBlur and Library.Toggled) then
                Library.BlurEffect.Enabled = false
            end
        end)
    end
end

function Library:SetFontSize(Size)
    Library.FontSize = Size
    for target in next, Library._FontTargets do
        if target and target.Parent then
            local offset = target:GetAttribute('FontSizeOffset') or 0
            target.TextSize = Size + offset
        else
            Library._FontTargets[target] = nil
        end
    end
end

local RainbowStep, Hue = 0, 0
local RainbowConn
local function ensureRainbow()
    if RainbowConn then return end
    RainbowConn = RenderStepped:Connect(function(Delta)
        RainbowStep = RainbowStep + Delta
        if RainbowStep >= (1 / 60) then
            RainbowStep = 0
            Hue = Hue + (1 / 400)
            if Hue > 1 then Hue = 0 end
            Library.CurrentRainbowHue   = Hue
            Library.CurrentRainbowColor = Color3.fromHSV(Hue, 0.8, 1)
        end
    end)
end
local function releaseRainbow()
    if RainbowConn and Library._RainbowConsumers <= 0 then
        RainbowConn:Disconnect()
        RainbowConn = nil
    end
end
function Library:AcquireRainbow()
    Library._RainbowConsumers = Library._RainbowConsumers + 1
    ensureRainbow()
end
function Library:ReleaseRainbow()
    Library._RainbowConsumers = math.max(0, Library._RainbowConsumers - 1)
    releaseRainbow()
end

