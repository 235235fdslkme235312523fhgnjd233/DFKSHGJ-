        Max      = Info.Max,
        Rounding = Info.Rounding,
        MaxSize  = 232,
        Type     = 'Slider',
        Callback = Info.Callback or function() end,
    }
    local Groupbox = self

    if not Info.Compact then
        Library:CreateLabel({
            Size           = UDim2.new(1, 0, 0, 10),
            TextSize       = Library.FontSize,
            Text           = Info.Text,
