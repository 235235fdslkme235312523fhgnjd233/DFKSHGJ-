-- ─────────────────────────────────────────────
--  Draggable (uses pooled frame, debounced)
-- ─────────────────────────────────────────────
function Library:MakeDraggable(instance, cutoff, isWindow)
    instance.Active = true
    local conn
    conn = instance.InputBegan:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1
            and input.UserInputType ~= Enum.UserInputType.Touch then return end
        local startPos = instance.Position
        local dragStart = input.Position
        if (dragStart.Y - instance.AbsolutePosition.Y) > (cutoff or 40) then return end

        local hasMoved, wireframe = false, nil
        local cc, ec

        cc = Library:GiveSignal(InputService.InputChanged:Connect(function(ch)
            if ch.UserInputType ~= Enum.UserInputType.MouseMovement and ch ~= input then return end
            local delta = ch.Position - dragStart
            if isWindow and Library.WireframeDrag then
                if not hasMoved and delta.Magnitude > 2 then
                    hasMoved = true
                    wireframe = Library:Create('Frame', {
                        Size = instance.Size,
                        Position = instance.Position,
                        AnchorPoint = instance.AnchorPoint,
                        BackgroundTransparency = 1,
                        Active = false,
                        ZIndex = 100000,
                        Parent = ScreenGui,
                    })
                    Library:Create('UIStroke', {
                        Color = Color3.new(1, 1, 1),
                        Thickness = 1,
                        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
                        Parent = wireframe,
                    })
                end
                if hasMoved and wireframe then
                    wireframe.Position = UDim2.new(
                        startPos.X.Scale, startPos.X.Offset + delta.X,
                        startPos.Y.Scale, startPos.Y.Offset + delta.Y
                    )
                end
            else
                instance.Position = UDim2.new(
                    startPos.X.Scale, startPos.X.Offset + delta.X,
                    startPos.Y.Scale, startPos.Y.Offset + delta.Y
                )
            end
        end))

        ec = Library:GiveSignal(InputService.InputEnded:Connect(function(e)
            if e ~= input and e.UserInputType ~= Enum.UserInputType.Touch then return end
            cc:Disconnect()
            ec:Disconnect()
            if isWindow and Library.WireframeDrag and hasMoved and wireframe then
                instance.Position = wireframe.Position
                wireframe:Destroy()
            end
        end))
    end)
    Library:GiveSignal(conn)
end

-- ─────────────────────────────────────────────
--  Resizable
-- ─────────────────────────────────────────────
function Library:MakeResizable(instance, minSize, maxSize)
    minSize = minSize or Vector2.new(400, 300)
    maxSize = maxSize or Vector2.new(1400, 1000)

    local grip = Library:Create('TextButton', {
        Name = 'ResizeGrip',
        Text = '',
        AutoButtonColor = false,
        BackgroundTransparency = 1,
        Size = UDim2.fromOffset(16, 16),
        Position = UDim2.new(1, -4, 1, -4),
        AnchorPoint = Vector2.new(1, 1),
        ZIndex = 25,
        Parent = instance,
    })

    local icon = Library:CreateLabel({
        Size = UDim2.fromOffset(16, 16),
        Position = UDim2.new(1, 0, 1, 0),
        AnchorPoint = Vector2.new(1, 1),
        Text = '◢',
        TextColor3 = Library.OutlineColor,
        TextSize = Library.FontSize + 2,
        ZIndex = 26,
        Parent = grip,
    })
    Library:AddToRegistry(icon, {TextColor3 = 'OutlineColor'})

    Library:GiveSignal(grip.InputBegan:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1
            and input.UserInputType ~= Enum.UserInputType.Touch then return end
        local startSize = instance.Size
        local dragStart = input.Position
        local wireframe
        local cc, ec

        cc = Library:GiveSignal(InputService.InputChanged:Connect(function(ch)
            if ch.UserInputType ~= Enum.UserInputType.MouseMovement and ch ~= input then return end
            local delta = ch.Position - dragStart
            if delta.Magnitude <= 2 then return end
            local w = math.clamp(startSize.X.Offset + delta.X, minSize.X, maxSize.X)
            local h = math.clamp(startSize.Y.Offset + delta.Y, minSize.Y, maxSize.Y)
            local newSize = UDim2.fromOffset(w, h)
            if Library.WireframeDrag then
                if not wireframe then
                    wireframe = Library:Create('Frame', {
                        Size = instance.Size,
                        Position = instance.Position,
                        AnchorPoint = instance.AnchorPoint,
                        BackgroundTransparency = 1,
                        ZIndex = 100000,
                        Parent = ScreenGui,
                    })
                    Library:Create('UIStroke', {
                        Color = Color3.new(1, 1, 1),
                        Thickness = 1,
                        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
                        Parent = wireframe,
                    })
                end
                wireframe.Size = newSize
                wireframe.Position = instance.Position
            else
                instance.Size = newSize
            end
        end))

        ec = Library:GiveSignal(InputService.InputEnded:Connect(function(e)
            if e ~= input and e.UserInputType ~= Enum.UserInputType.Touch then return end
            cc:Disconnect()
            ec:Disconnect()
            if wireframe then
                instance.Size = wireframe.Size
                wireframe:Destroy()
            end
        end))
    end))
end

