    }, true)
    local InnerFrameN = Library:Create('Frame', {
        BackgroundColor3 = Color3.new(1, 1, 1),
        BorderSizePixel  = 0,
        Position         = UDim2.new(0, innerPosX, 0, innerPosY),
        Size             = UDim2.new(1, innerSizeW, 1, innerSizeH),
        ZIndex           = 102,
        Parent           = NotifyInner,
    })
    Library:Create('UIGradient', {
        Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Library.GetDarkerColor(Library.MainColor)),
            ColorSequenceKeypoint.new(1, Library.MainColor),
        }),
        Rotation = -90,
        Parent   = InnerFrameN,
    })
    Library:CreateLabel({
        Position       = UDim2.new(0, labelPosX, 0, 0),
        Size           = UDim2.new(1, labelSizeW, 1, 0),
        Text           = Text,
        TextXAlignment = (align == 'Center')
            and Enum.TextXAlignment.Center
            or  Enum.TextXAlignment.Left,
        TextSize       = Library.FontSize,
        ZIndex         = 103,
        Parent         = InnerFrameN,
    })
    local AccentBar = Library:Create('Frame', {
        BackgroundColor3 = Library.AccentColor,
        BorderSizePixel  = 0,
        ZIndex           = 104,
        Parent           = NotifyOuter,
    })
    if barSide == 'Left' then
        AccentBar.Position = UDim2.new(0, -1, 0, -1)
        AccentBar.Size     = UDim2.new(0, BAR, 1, 2)
    elseif barSide == 'Right' then
        AccentBar.Position = UDim2.new(1, -BAR + 1, 0, -1)
        AccentBar.Size     = UDim2.new(0, BAR, 1, 2)
    elseif barSide == 'Top' then
        AccentBar.Position = UDim2.new(0, -1, 0, -1)
        AccentBar.Size     = UDim2.new(1, 2, 0, BAR)
    elseif barSide == 'Bottom' then
        AccentBar.Position = UDim2.new(0, -1, 1, -BAR + 1)
        AccentBar.Size     = UDim2.new(1, 2, 0, BAR)
    end
    Library:AddToRegistry(AccentBar, { BackgroundColor3 = 'AccentColor' }, true)

    local finalWidth = XSize + 8 + 4
    if barSide == 'Left' or barSide == 'Right' then
        finalWidth = finalWidth + BAR
    end

    local openTween = TweenService:Create(
        NotifyOuter,
        TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        { Size = UDim2.new(0, finalWidth, 0, YSize) }
    )
    openTween:Play()

    task.delay(Time or 5, function()
        if not NotifyOuter.Parent then return end
        local closeTween = TweenService:Create(
            NotifyOuter,
            TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
            { Size = UDim2.new(0, 0, 0, YSize) }
        )
        closeTween:Play()
        closeTween.Completed:Connect(function()
            if NotifyOuter.Parent then NotifyOuter:Destroy() end
        end)
    end)
end

function Library:CreateWindow(...)
