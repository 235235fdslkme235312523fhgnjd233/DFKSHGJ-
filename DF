function Library:AddToolTip(text, hoverInstance)
    local x, y = Library:GetTextBounds(text, Library.Font, Library.FontSize)

    Library:GiveSignal(hoverInstance.MouseEnter:Connect(function()
        if Library:MouseIsOverOpenedFrame() then return end
        Library._tooltipLabel.Text = text
        Library._tooltip.Size = UDim2.fromOffset(x + 6, y + 4)
        Library._tooltip.Position = UDim2.fromOffset(Mouse.X + 15, Mouse.Y + 12)
        Library._tooltip.Visible = true
        Library._tooltipActive = true
    end))

    Library:GiveSignal(hoverInstance.MouseLeave:Connect(function()
        Library._tooltip.Visible = false
        Library._tooltipActive = false
    end))
end

-- ─────────────────────────────────────────────
--  Hover highlight (pre-built tables, no alloc)
-- ─────────────────────────────────────────────
function Library:OnHighlight(hoverInstance, targetInstance, hoverProps, defaultProps)
    Library:GiveSignal(hoverInstance.MouseEnter:Connect(function()
        local reg = Library.RegistryMap[targetInstance]
        for prop, colorKey in next, hoverProps do
            targetInstance[prop] = Library[colorKey] or colorKey
            if reg and reg.Properties[prop] then reg.Properties[prop] = colorKey end
        end
    end))
    Library:GiveSignal(hoverInstance.MouseLeave:Connect(function()
        local reg = Library.RegistryMap[targetInstance]
        for prop, colorKey in next, defaultProps do
            targetInstance[prop] = Library[colorKey] or colorKey
            if reg and reg.Properties[prop] then reg.Properties[prop] = colorKey end
        end
    end))
end

