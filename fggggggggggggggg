function Library:AddToolTip(InfoStr, HoverInst)
    local X, Y = Library:GetTextBounds(InfoStr, Library.Font, 14)
    local Tip = Library:Create('Frame', {
        BackgroundColor3 = Library.MainColor,
        BorderColor3     = Library.OutlineColor,
        Size             = UDim2.fromOffset(X+5, Y+4),
        ZIndex           = 100,
        Visible          = false,
        Parent           = ScreenGui,
    })
    Library:CreateLabel({
        Position       = UDim2.fromOffset(3,1),
        Size           = UDim2.fromOffset(X,Y),
        TextSize       = 14,
        Text           = InfoStr,
        TextColor3     = Library.FontColor,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex         = 101,
        Parent         = Tip,
    })
    Library:AddToRegistry(Tip, { BackgroundColor3='MainColor', BorderColor3='OutlineColor' })

    local hovering = false
    HoverInst.MouseEnter:Connect(function()
        if Library:MouseIsOverOpenedFrame() then return end
        hovering = true
        Tip.Visible = true
        while hovering do
            Tip.Position = UDim2.fromOffset(Mouse.X+15, Mouse.Y+12)
            Heartbeat:Wait()
        end
    end)
    HoverInst.MouseLeave:Connect(function()
        hovering = false
        Tip.Visible = false
    end)
end

-- ── 하이라이트 ───────────────────────────────────────────────────────────
function Library:OnHighlight(HoverInst, Target, On, Off)
    local Reg = Library.RegistryMap[Target]
    HoverInst.MouseEnter:Connect(function()
        for P, V in next, On do
            Target[P] = Library[V] or V
            if Reg and Reg.Properties[P] then Reg.Properties[P] = V end
        end
    end)
    HoverInst.MouseLeave:Connect(function()
        for P, V in next, Off do
            Target[P] = Library[V] or V
            if Reg and Reg.Properties[P] then Reg.Properties[P] = V end
        end
    end)
end

-- ── 마우스 오버 체크 ─────────────────────────────────────────────────────
function Library:MouseIsOverOpenedFrame()
    local mx, my = Mouse.X, Mouse.Y
    for Frame in next, Library.OpenedFrames do
        local p, s = Frame.AbsolutePosition, Frame.AbsoluteSize
        if mx >= p.X and mx <= p.X+s.X and my >= p.Y and my <= p.Y+s.Y then
            return true
        end
    end
end

function Library:IsMouseOverFrame(Frame)
    local p, s = Frame.AbsolutePosition, Frame.AbsoluteSize
    return Mouse.X >= p.X and Mouse.X <= p.X+s.X and Mouse.Y >= p.Y and Mouse.Y <= p.Y+s.Y
end

-- ── DependencyBox 업데이트 ──────────────────────────────────────────────
function Library:UpdateDependencyBoxes()
    for _, db in next, Library.DependencyBoxes do db:Update() end
end

-- ── 수학 유틸 ───────────────────────────────────────────────────────────
function Library:MapValue(v, minA, maxA, minB, maxB)
    local t = (v - minA) / (maxA - minA)
    return (1-t)*minB + t*maxB
end

function Library:GetTextBounds(Text, Font, Size, Res)
    local b = TextService:GetTextSize(Text, Size, Font, Res or Vector2.new(1920,1080))
    return b.X, b.Y
end

-- ── Registry ─────────────────────────────────────────────────────────────
function Library:AddToRegistry(Inst, Props, IsHud)
    local data = { Instance=Inst, Properties=Props, Idx=#Library.Registry+1 }
    table.insert(Library.Registry, data)
    Library.RegistryMap[Inst] = data
    if IsHud then table.insert(Library.HudRegistry, data) end
end

function Library:RemoveFromRegistry(Inst)
    local data = Library.RegistryMap[Inst]
    if not data then return end
    for i = #Library.Registry, 1, -1 do
        if Library.Registry[i] == data then table.remove(Library.Registry, i) end
    end
    for i = #Library.HudRegistry, 1, -1 do
        if Library.HudRegistry[i] == data then table.remove(Library.HudRegistry, i) end
    end
    Library.RegistryMap[Inst] = nil
end

-- 최적화: dirty flag 기반 색상 업데이트
function Library:UpdateColorsUsingRegistry()
    for _, obj in next, Library.Registry do
        for P, V in next, obj.Properties do
            local inst = obj.Instance
            if type(V) == 'string' then
                inst[P] = Library[V]
            elseif type(V) == 'function' then
                inst[P] = V()
            end
        end
    end
end

function Library:GiveSignal(Signal)
    table.insert(Library.Signals, Signal)
end

function Library:Unload()
    for i = #Library.Signals, 1, -1 do
        table.remove(Library.Signals, i):Disconnect()
    end
    if Library.OnUnload then Library.OnUnload() end
    ScreenGui:Destroy()
end

Library:GiveSignal(ScreenGui.DescendantRemoving:Connect(function(Inst)
    if Library.RegistryMap[Inst] then Library:RemoveFromRegistry(Inst) end
end))

